{
  "telemetry.enableTelemetry": false,
  "explorer.confirmDelete": false,
  "editor.formatOnSave": true,
  "editor.lineHeight": 35,
  "workbench.colorTheme": "Matugen",
  "editor.fontLigatures": true,
  "workbench.editor.untitled.hint": "hidden",
  "editor.fontSize": 14,
  "workbench.iconTheme": "file-icons-colourless",
  "breadcrumbs.enabled": false,
  "editor.padding.top": 10,
  "editor.minimap.enabled": false,
  "workbench.editor.showTabs": "none",
  "vim.useSystemClipboard": true,
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "workbench.sideBar.location": "right",
  "editor.codeLens": false,
  "editor.fontFamily": "\"Fira Code\", \"Cascadia Code\", \"JetBrains Mono\", monospace",
  "explorer.confirmDragAndDrop": false,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.tabSize": 2,
  "vim.smartRelativeLine": true,
  "workbench.layoutControl.enabled": false,
  "editor.inlineSuggest.enabled": true,
  "workbench.activityBar.location": "hidden",
  "editor.fontWeight": "500",
  "files.autoSave": "afterDelay",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "window.menuBarVisibility": "hidden",
  "workbench.browser.showInTitleBar": true,
  "window.titleBarStyle": "custom",
  "window.controlsStyle": "hidden",
  "window.commandCenter": false,
  "workbench.editor.empty.hint": "hidden",
  "workbench.tips.enabled": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  "editor.stickyScroll.enabled": true,
  "workbench.list.smoothScrolling": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "zenMode.centerLayout": true,
  "zenMode.hideActivityBar": true,
  "zenMode.hideStatusBar": true,
  "zenMode.hideLineNumbers": false,
  "zenMode.fullScreen": false,
  "zenMode.showTabs": "none",
  "zenMode.silentNotifications": true,
  "zenMode.restore": true,
  "workbench.editor.centeredLayoutAutoResize": true,
  "workbench.editor.centeredLayoutFixedWidth": true,
  "custom-ui-style.stylesheet": {
    ".monaco-workbench .part.titlebar .window-appicon": {
      "display": "none"
    }
  },
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.overviewRulerBorder": false,
  "workbench.editor.titleScrollbarVisibility": "hidden"
}
